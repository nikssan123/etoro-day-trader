# Copy to .env and fill in. .env is gitignored — never commit it.

# Your personal eToro API key (the x-user-key). ~260 characters, every character
# significant — paste it verbatim, do not retype or line-wrap it.
# On your Mac it is already on the etoro-public-api entry in ~/.claude.json.
ETORO_USER_KEY=

# Timezone the cron schedule is interpreted in. The cycle times in docker/crontab
# assume the US session falls at 16:30-23:00 local.
TZ=Europe/Sofia

# Optional. Leave blank to use your Claude subscription instead, via:
#   docker compose run --rm bot claude login
# Setting a key bills every cycle per token on top of your subscription.
ANTHROPIC_API_KEY=

# Cloudflare Tunnel token, from Zero Trust > Networks > Tunnels > your tunnel.
# The tunnel dials out to Cloudflare, so no inbound port is ever opened on the VPS.
TUNNEL_TOKEN=

# NOTE: the dashboard's own secrets live in .env.dashboard, not here — see
# .env.dashboard.example. That split keeps ETORO_USER_KEY out of the
# internet-facing container.
