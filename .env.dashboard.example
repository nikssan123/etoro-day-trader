# Copy to .env.dashboard and fill in. Gitignored — never commit it.
#
# This file is loaded with docker compose `env_file`, which does NOT do variable
# interpolation. That matters: a bcrypt hash contains `$` characters, and passing it
# through `environment:` instead would let compose eat them and silently produce a
# hash that never matches. Do not move these into .env.
#
# Do not quote the values here — env_file treats quotes as part of the value.

# bcrypt hash of your dashboard password. Generate with:
#   docker compose run --rm --no-deps --entrypoint node dashboard server/src/hash-password.js 'your password'
# Paste the output (starts with $2b$12$). Never store the password itself.
DASHBOARD_PASSWORD_HASH=

# Signs the session cookie. At least 32 characters:
#   openssl rand -hex 32
# Changing this invalidates every existing session — that is how you force a re-login
# if you ever think the cookie leaked.
JWT_SECRET=
